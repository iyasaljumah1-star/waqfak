# ─────────────────────────────────────────────────────────────────────────────
# Waqfak (وقفك) — production configuration. Copy to .env and fill in.
# deploy/install.sh generates every secret below automatically. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Public domain (DNS A/AAAA record must point to this server before first start)
DOMAIN=waqfak.sa
ACME_EMAIL=it@waqfak.sa

# Database passwords (hex/alphanumeric only — they are embedded in connection URLs)
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
OWNER_DB_PASSWORD=

# Encryption & session keys — 32 random bytes, base64 (openssl rand -base64 32).
# MASTER_KEY encrypts documents and personal data: back it up OFFLINE. Losing it = losing the data.
MASTER_KEY=
HASH_KEY=
SESSION_SECRET=

# Demo OTP display. MUST be false once an SMS provider is connected (true only for a staging/demo server).
DEMO_SHOW_OTP=false

# SMS: outbox | taqnyat | unifonic | msegat   (sender name must be registered with CST)
SMS_PROVIDER=outbox
SMS_API_KEY=
SMS_SENDER=
SMS_USERNAME=

# Email: outbox | smtp
EMAIL_PROVIDER=outbox
SMTP_URL=
EMAIL_FROM=وقفك <no-reply@waqfak.sa>

# Document storage: local (Docker volume) | s3 (any S3-compatible bucket, preferably in-Kingdom)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payments: sandbox until a licensed gateway account exists (feature flag payments.live stays off)
PAYMENT_PROVIDER=sandbox

# Assistant: local engine by default. External LLM only after the ai.external_llm flag + PDPL transfer review.
AI_PROVIDER=local
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional: allow POST /api/jobs/daily with header x-job-secret (the jobs container already runs it daily)
JOB_SECRET=

BACKUP_RETENTION_DAYS=14
